{
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev:web": "vite --config vite.web.config.ts",
    "check:web": "tsc --noEmit -p web-spa/tsconfig.json",
    "check:bundle": "node scripts/check-bundle.mjs",
    "build:web": "vite build --config vite.web.config.ts",
    "build:cloudflare": "CREW_DEPLOY_TARGET=cloudflare vite build --config vite.web.config.ts && node scripts/prepare-cloudflare.mjs",
    "test:cloudflare": "CREW_CLOUDFLARE_TEST=1 node --test tests/cloudflare-deployment.test.js",
    "test:browser:cloudflare": "node tests/cloudflare-browser-smoke.mjs"
  },
  "dependencies": {
    "i18next": "^25.0.0",
    "react-i18next": "^16.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
