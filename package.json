{
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js tests/*.test.mjs",
    "dev:web": "vite --config vite.web.config.ts",
    "check:web": "tsc --noEmit -p web-spa/tsconfig.json",
    "check:bundle": "node scripts/check-bundle.mjs",
    "build:web": "vite build --config vite.web.config.ts",
    "build:cloudflare": "CREW_DEPLOY_TARGET=cloudflare vite build --config vite.web.config.ts && node scripts/prepare-cloudflare.mjs",
    "test:cloudflare": "CREW_CLOUDFLARE_TEST=1 node --test tests/cloudflare-deployment.test.js",
    "test:browser:cloudflare": "node tests/cloudflare-browser-smoke.mjs",
    "shorts:plan": "node scripts/generate-shorts-daily.mjs --mode plan",
    "shorts:preview": "node scripts/generate-shorts-daily.mjs --mode preview",
    "shorts:generate": "node scripts/generate-shorts-daily.mjs --mode preview",
    "shorts:review": "node scripts/shorts-review.mjs",
    "shorts:submit": "node scripts/shorts-submit.mjs",
    "check:i18n": "node scripts/check-ui-locales.mjs"
  },
  "dependencies": {
    "i18next": "^25.0.0",
    "react-i18next": "^16.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zustand": "5.0.15",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.8.1",
    "three": "0.182.0",
    "pinyin-pro": "3.29.5",
    "opencc-js": "1.4.2",
    "page-flip": "2.0.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "@types/three": "0.182.0"
  }
}
