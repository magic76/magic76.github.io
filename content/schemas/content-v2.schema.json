{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crew Content Hub v2",
  "type": "object",
  "required": [
    "schema",
    "type",
    "id",
    "status",
    "publishedAt",
    "locales",
    "media"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "type": {
      "enum": [
        "article",
        "moment"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,95}$"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "scheduled",
        "published",
        "archived"
      ]
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "authorId": {
      "type": "string"
    },
    "storyId": {
      "type": "string"
    },
    "locales": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "assetId",
          "url"
        ],
        "properties": {
          "type": {
            "enum": [
              "image",
              "video"
            ]
          },
          "assetId": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "posterUrl": {
            "type": "string"
          },
          "durationSec": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
