# Keep Cloudflare Pages preview/deployment aliases out of Google results.
# www.3sssi.com remains indexable and continues to advertise its canonical URLs.
https://magic76-github-io.pages.dev/*
  X-Robots-Tag: noindex

https://:version.magic76-github-io.pages.dev/*
  X-Robots-Tag: noindex

# Private analytics is not a public SEO entry point.
/usage*
  X-Robots-Tag: noindex
  Cache-Control: no-store

/api/usage/*
  X-Robots-Tag: noindex
  Cache-Control: no-store

# Only Vite's fingerprinted build output is immutable. /assets/ also contains
# unversioned character photos, so never apply this rule to /assets/*.
/assets/build/*
  Cache-Control: public, max-age=31536000, immutable

# The version endpoint must bypass browser and Cloudflare caches so open tabs
# can detect a newly deployed build without reloading the whole app.
/version.json
  Cache-Control: no-store, max-age=0, must-revalidate

# Keep the SW and manifest fresh; never reuse stale install/update metadata.
/sw.js
  Cache-Control: no-store, max-age=0, must-revalidate

/site.webmanifest
  Cache-Control: no-cache, must-revalidate

/offline.html
  Cache-Control: no-cache, must-revalidate

# Playtest is intentionally unindexed and updates frequently.
/neon-swarm-lab/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store, max-age=0

/feedback*
  X-Robots-Tag: noindex

/api/feedback
  X-Robots-Tag: noindex
  Cache-Control: no-store
