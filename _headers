# Keep Cloudflare Pages preview/deployment aliases out of Google results.
# koolo.app is canonical; both public domains remain indexable until the legacy 301 rules are enabled.
https://magic76-github-io.pages.dev/*
  X-Robots-Tag: noindex

https://:version.magic76-github-io.pages.dev/*
  X-Robots-Tag: noindex

# Purchased report library is private account content; never index or cache it.
/fortune/purchases*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/api/fortune/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store

# Authenticated voice credits are private account information.
/me/voice-credits*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/api/voice/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store

# Private analytics is not a public SEO entry point.
/usage*
  X-Robots-Tag: noindex
  Cache-Control: no-store

/api/usage/*
  X-Robots-Tag: noindex
  Cache-Control: no-store

# Only Vite's fingerprinted build output is immutable. /assets/ also contains
# unversioned character photos, so never apply this rule to /assets/*.
/assets/build/*
  Cache-Control: public, max-age=31536000, immutable

# Pages maps 404.html to the extensionless URL. Both direct asset URLs are
# real 200/redirect responses, unlike a missing chunk's 404. Detach the broad
# immutable rule first: matching _headers rules are merged in file order.
/assets/build/404.html
  ! Cache-Control
  Cache-Control: no-store

/assets/build/404
  ! Cache-Control
  Cache-Control: no-store

# The version endpoint must bypass browser and Cloudflare caches so open tabs
# can detect a newly deployed build without reloading the whole app.
/version.json
  Cache-Control: no-store, max-age=0, must-revalidate

# Keep the SW and manifest fresh; never reuse stale install/update metadata.
/sw.js
  Cache-Control: no-store, max-age=0, must-revalidate

/site.webmanifest
  Cache-Control: no-cache, must-revalidate

/offline.html
  Cache-Control: no-cache, must-revalidate


/feedback*
  X-Robots-Tag: noindex

/api/feedback
  X-Robots-Tag: noindex
  Cache-Control: no-store

# Stage-only payment tests must never be indexed or cached.
/fortune/ecpay/test*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/api/fortune/ecpay/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Private lab JavaScript contains no secrets and must update immediately in installed PWAs.
/assets/js/fortune-report-lab.js
  Cache-Control: no-store, max-age=0
  X-Content-Type-Options: nosniff

