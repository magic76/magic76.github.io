{
  "schemaVersion": 1,
  "revision": "2026-11-25.1",
  "owner": "magic76/crew-teacher",
  "canonical": "https://github.com/magic76/crew-teacher/blob/main/contracts/crew-teacher/v1.json",
  "platforms": [
    "android",
    "web"
  ],
  "rules": {
    "freeChat": {
      "questionRequiredEachTurn": false,
      "pivotAfterShortReplies": 2,
      "pivotAfterConsecutiveQuestions": 3,
      "firstSilenceMs": 9000,
      "secondSilenceMs": 16000,
      "maxSilentRescueNudges": 2,
      "sessionCadenceIsEphemeral": true,
      "lowEngagementFirstSilenceMs": 8000,
      "highEngagementFirstSilenceMs": 11000,
      "noNudgeAfterGoodbye": true,
      "topicContinuationHook": true
    },
    "friends": {
      "inCharacter": true,
      "noUnsolicitedCoaching": true,
      "selectedSpokenLanguageLocked": false,
      "languageLockSurvivesReconnect": true,
      "chatLanguageModes": [
        "natural",
        "bilingual",
        "immersion"
      ],
      "defaultChatLanguageMode": "bilingual",
      "explicitBilingualIsNotLanguageDrift": true,
      "chatModeSurvivesReconnect": true,
      "explicitModeChangeDuringLive": true,
      "switchAppliesToNextReplyWithoutRestart": true,
      "roleUxPromiseWithoutUnsolicitedCorrections": true,
      "singleLanguagePerSpokenReply": true,
      "naturalDefaultsToNativeLanguage": true,
      "naturalFollowsSustainedLanguage": true,
      "naturalIgnoresOneWordLanguageSwitch": true,
      "assistedTargetFirstNativeHelpWholeReply": true,
      "immersionAlwaysTargetOnly": true,
      "friendFirstSilenceMs": 20000,
      "friendMaxSilentNudges": 1,
      "noCompulsoryOpeningQuestion": true,
      "chatModeLabels": {
        "natural": "Native-language chat / 母語聊天",
        "bilingual": "Easy target-language chat / 輕鬆外語聊天",
        "immersion": "Full immersion / 完全沉浸"
      },
      "savedExplicitChatModePreserved": true,
      "newUserTargetLanguageFirst": true,
      "adaptiveDifficultyWithoutCefrOrCorrections": true,
      "adaptiveBasedOnSustainedConversationNotSingleWords": true
    },
    "memory": {
      "personalDefaultOn": true,
      "friendTopicDefaultOn": true,
      "explicitOptOutPreserved": true,
      "doNotFabricateMemories": true,
      "verifiedSameCharacterTopicsAreFirsthand": true,
      "editedTopicsNotProofOfPriorConversation": true,
      "sharedLearnerProfileNotProofOfPriorConversation": true,
      "doNotDescribeFirsthandChatsAsHearsay": true,
      "fictionalLifeBookNotSharedLearnerHistory": true
    },
    "practice": {
      "mayPromptForRepetition": true,
      "roleplayStaysInCharacter": true,
      "freeChatRulesDoNotOverrideLessons": true
    },
    "shortsHomepage": {
      "displayBeforeSecondaryFeatureCards": true,
      "maximumPreviewCards": 10,
      "onePreviewPerFriend": true,
      "previewPhotoOpensFullPublishedPost": true,
      "explicitChatActionUsesExistingFriendLive": true,
      "farEdgeSwipesOfferFullFeed": true,
      "noNewAudioStack": true
    },
    "fortuneSpeaking": {
      "optInOnly": true,
      "reuseExistingLiveStack": true,
      "dailyTopicIsReflectionNotPrediction": true,
      "readingSummaryIsUntrustedData": true,
      "noFabricatedChartFacts": true,
      "respectExistingLanguageAndMemoryPreferences": true,
      "noExtraModelCallsForDailyTopic": true,
      "singleTeacherFortuneEntry": true,
      "reuseWebFortuneCalculator": true,
      "readingReuseIsDeviceLocal": true,
      "nativeVoiceReceivesOnlyOptedInSummary": true,
      "embeddedWebViewHasNoJavascriptBridge": true,
      "fortuneVoiceIsFriendLedExplanation": true,
      "explainBeforeVisitorQuestions": true,
      "naturalInterruptionsNoForcedQuizzes": true,
      "computedReadingOnlyNoFabrication": true
    },
    "release": {
      "androidPlayAabManual": true,
      "webDeployAfterMerge": true
    },
    "voiceDiversity": {
      "officialLiveVoiceCount": 30,
      "previewUsesLiveModel": true,
      "accentIsBestEffort": true,
      "accentDoesNotOverrideSelectedLanguage": true,
      "voiceLabAndroidDebugOnly": true,
      "ratingsStoredLocally": true,
      "languageNeutralCharacterAccent": true,
      "modelSelector": [
        "gemini-3.8-live",
        "gemini-3.1-flash-live-preview"
      ],
      "explicitModelNoFallback": true,
      "otherProductsRetainFallback": true,
      "voiceLabWebRetired": true
    },
    "teacherLanguageSupport": {
      "levelOptions": [
        "auto",
        "A1",
        "A2",
        "B1",
        "B2"
      ],
      "defaultLevel": "auto",
      "nativeLanguageForExplanations": true,
      "targetLanguageForExamples": true,
      "levelNotInferredFromVocabularyAlone": true,
      "explicitImmersionWins": true,
      "teacherFriendModeSeparated": true,
      "nativeLanguageQuestionsWelcomed": true,
      "responseScaffoldingVariesBySpeakingLevel": true,
      "modeSpecificUxPromise": true,
      "noManualLanguageRatio": true,
      "a1SpokenNativeScaffoldingFromFirstTurn": true,
      "nativeHelpAppliesToNaturalChat": true,
      "nativeQuestionsAnsweredInNativeWhenNotImmersion": true,
      "levelOverridesTargetFirstExceptImmersion": true
    },
    "teacherSpeakingProgress": {
      "source": "eligibleTeacherSessionReportsOnly",
      "minDurationSeconds": 60,
      "minUserTurns": 3,
      "minStudentWords": 20,
      "minEvidenceSessions": 3,
      "recentMedianWindow": 5,
      "maxChangePerNewReport": 1,
      "verbatimStudentQuoteRequired": true,
      "notCertifiedCefr": true,
      "vocabularyQuizDoesNotDetermineSpeakingLevel": true,
      "manualLevelWins": true,
      "roleplayAndFriendsExcluded": true,
      "perLanguageLocalOnly": true,
      "personalMemoryOptOutDisablesAndClears": true,
      "clearingLearningMemoryClearsProfile": true,
      "noAdditionalModelCalls": true
    },
    "conversationIntents": {
      "choices": [
        "share",
        "speak",
        "continue"
      ],
      "intentIsOptional": true,
      "originalRoleSelectorsRemain": true,
      "noFictionalMemoryOrPastEvents": true,
      "noUnsolicitedFriendCoaching": true,
      "informalThreeMinuteTargetNotHardTimer": true,
      "speakingEntryUsesSessionOnlyLanguageAssistance": true,
      "teacherUsesVerifiedMemoryOrFreshFallback": true,
      "neitherModeNorPreferencePersistedByQuickEntry": true,
      "sameGeminiLiveAndNoAdditionalCalls": true
    },
    "turnTaking": {
      "provider": "Gemini Live automatic server VAD",
      "sessionSetupOnly": true,
      "levelsMs": {
        "A1": 2000,
        "A2": 1400,
        "B1": 1000,
        "B2": 800,
        "auto": 1200
      },
      "endSensitivity": "LOW for A1/A2; HIGH for B1/B2/Auto",
      "scope": "Crew Teacher and Crew Friends on Android/Web; preserve separate silence rescue and other Crew products",
      "listeningStatus": "After actual microphone speech, show a gentle waiting hint during a pause; never send client activityEnd for this UI"
    }
  },
