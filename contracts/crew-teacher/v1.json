  "manualAcceptance": [
    {
      "id": "short_replies",
      "steps": "Speak to Zoe: Yes → Okay → No. Friend shares or pivots instead of interrogating.",
      "platforms": [
        "android",
        "web"
      ]
    },
    {
      "id": "teacher_recovery",
      "steps": "In natural chat give an incomplete answer, pause; teacher encourages gently without demanding repetition.",
      "platforms": [
        "android",
        "web"
      ]
    },
    {
      "id": "immersion_language",
      "steps": "Select English, speak Chinese once, and reconnect. Friend keeps replying in English.",
      "platforms": [
        "android",
        "web"
      ]
    },
    {
      "id": "roleplay",
      "steps": "Open a restaurant scenario. The character stays in scene, never provides unsought grammar coaching.",
      "platforms": [
        "android",
        "web"
      ]
    },
    {
      "id": "memory_off",
      "steps": "Disable friend topic and personal memory; reconnect and verify no saved topics are injected.",
      "platforms": [
        "android",
        "web"
      ]
    },
    {
      "id": "camera",
      "steps": "Grant/deny camera, check aspect ratio, pause image sharing, background/foreground, and transcript scroll.",
      "platforms": [
        "android",
        "web"
      ]
    },
    {
      "id": "friend_three_modes",
      "steps": "Start Zoe in natural, relaxed bilingual and immersion: native rescue only in natural; native replies allowed in relaxed bilingual; immersion replies only in target language, including after reconnect.",
      "platforms": [
        "android",
        "web"
      ]
    }
  ]
}
