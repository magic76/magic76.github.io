      "web": "supported",
      "androidEntry": "app/src/main/java/com/crewpocket/teacher/TeacherPersonaPolicy.java",
      "webEntry": "web-spa/src/teacher/teacherProfiles.ts"
    },
    {
      "id": "free_chat",
      "label": "Teacher natural chat and Friend natural chat",
      "android": "supported",
      "web": "supported",
      "androidEntry": "app/src/main/java/com/crewpocket/teacher/ConversationFlowPolicy.java",
      "webEntry": "web-spa/src/live/conversationFlow.ts"
