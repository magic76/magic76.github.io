{
  "schemaVersion": 1,
  "revision": "2026-10-13.5",
  "owner": "magic76/crew-teacher",
  "canonical": "https://github.com/magic76/crew-teacher/blob/main/contracts/crew-teacher/v1.json",
  "platforms": [
    "android",
    "web"
  ],
  "rules": {
    "freeChat": {
      "questionRequiredEachTurn": false,
      "pivotAfterShortReplies": 2,
      "pivotAfterConsecutiveQuestions": 3,
      "firstSilenceMs": 9000,
      "secondSilenceMs": 16000,
      "maxSilentRescueNudges": 2,
      "sessionCadenceIsEphemeral": true,
      "lowEngagementFirstSilenceMs": 8000,
      "highEngagementFirstSilenceMs": 11000,
      "noNudgeAfterGoodbye": true,
      "topicContinuationHook": true
    },
    "friends": {
      "inCharacter": true,
      "noUnsolicitedCoaching": true,
      "selectedSpokenLanguageLocked": true,
      "languageLockSurvivesReconnect": true,
      "chatModeDefault": "natural",
      "chatModes": [
        "natural",
        "bilingual",
        "immersion"
      ],
      "nativeLanguageHelpInNaturalChat": true,
      "noThirdLanguageInBilingual": true
    },
    "memory": {
      "personalDefaultOn": true,
      "friendTopicDefaultOn": true,
      "explicitOptOutPreserved": true,
      "doNotFabricateMemories": true
    },
    "practice": {
      "mayPromptForRepetition": true,
      "roleplayStaysInCharacter": true,
      "freeChatRulesDoNotOverrideLessons": true
    },
    "release": {
      "androidPlayAabManual": true,
      "webDeployAfterMerge": true
    },
    "voiceDiversity": {
      "officialLiveVoiceCount": 30,
      "previewUsesLiveModel": true,
      "accentIsBestEffort": true,
      "accentDoesNotOverrideSelectedLanguage": true,
      "voiceLabAndroidDebugOnly": true,
      "voiceLabWebOptIn": true,
      "ratingsStoredLocally": true,
      "languageNeutralCharacterAccent": true,
      "modelSelector": [
        "gemini-3.8-live",
        "gemini-3.1-flash-live-preview"
      ],
      "explicitModelNoFallback": true,
      "otherProductsRetainFallback": true
    },
    "teacher": {
      "bilingualNativeLanguageTeaching": true,
      "scaffoldingFollowsDemonstratedAbility": true,
      "immersionRemainsTargetOnly": true
    }
  },
  "featureMatrix": [
    {
      "id": "friend_profiles",
      "label": "16 Crew Friends; stable identity, avatar and voice",
      "android": "supported",
      "web": "supported",
