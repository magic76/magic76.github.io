        {
          "path": "app/src/main/java/com/crewpocket/teacher/ConversationFlowPolicy.java",
          "contains": [
            "Questions are OPTIONAL",
            "shortReplyStreak >= 2 || questionStreak >= 3",
            "never turn into a tutor",
            "conversational hook"
          ]
        }
      ],
      "web": [
        {
          "path": "web-spa/src/live/conversationFlow.ts",
          "contains": [
            "You do NOT have to ask a question",
            "this.shortReplies>=2||this.questions>=3",
            "NEVER switch to teaching",
            "conversational hook"
          ]
        }
      ]
    },
    {
